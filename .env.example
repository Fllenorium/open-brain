# Postgres. Leave it unset and Open Brain runs on PGlite in .openbrain/pgdata —
# real Postgres compiled to wasm, nothing to install. Point it at a server for
# anything you care about.
# DATABASE_URL=postgres://user:pass@host:5432/openbrain

# Human auth, in order of precedence.
#
# One key, one owner — the honest model for a single-user product, and what a
# deployment needs if you don't want an account with anyone. Sign in at /unlock.
#   openssl rand -base64 24
# OPENBRAIN_OWNER_KEY=
#
# Or Clerk, which wins when both are set.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
#
# With neither, Open Brain runs as a local single-user instance, and refuses to
# start that way in production.

# Review, Ask, Continue, and import descriptions. Everything else works without it.
# ANTHROPIC_API_KEY=sk-ant-...

# Credentials. 32 bytes, base64. Without it the secrets screen stays off, and
# the app fails closed at boot if secrets already exist.
#   openssl rand -base64 32
# OPENBRAIN_MASTER_KEY=

# Git mirror. Writes markdown to .openbrain/mirror/<user> as a real git repo.
# Add a remote and a token and it pushes there too. OPENBRAIN_GIT_MIRROR=off turns it off.
# OPENBRAIN_GIT_REMOTE=https://github.com/you/brain-mirror.git
# GITHUB_TOKEN=ghp_...

# Upgrading from Papyrus? Every PAPYRUS_* name above is still read when the
# OPENBRAIN_* one isn't set, so nothing needs changing on a running deployment.
